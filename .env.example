# Telegram Bot Token (텔레그램 @BotFather에게서 발급받은 토큰)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Google AI Studio에서 무료 발급: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 경로 설정 (기본값 유지 권장)
DB_PATH=/silup/data/silup.db
RULES_PATH=/silup/knowledge/rules.json
KNOWLEDGE_PATH=/silup/knowledge/knowledge_base.md
TIMEZONE=Asia/Seoul
